#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Entry point of the AppImage: points the MySQL client library at its bundled plugins (Qt finds its plugins through
# usr/bin/qt.conf).
HERE="$(dirname "$(readlink -f "$0")")"
export MARIADB_PLUGIN_DIR="$HERE/usr/lib/mariadb/plugin"

exec "$HERE/usr/bin/querymole" "$@"
