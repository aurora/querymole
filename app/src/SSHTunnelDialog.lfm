object SSHTunnelForm: TSSHTunnelForm
  Left = 400
  Top = 200
  BorderStyle = bsDialog
  Caption = 'SSH Tunnel'
  ClientHeight = 312
  ClientWidth = 400
  Color = clBtnFace
  Font.Height = -11
  Font.Name = 'MS Sans Serif'
  Position = poMainFormCenter
  OnCreate = FormCreate
  OnShow = FormShow
  object SSHGBox: TGroupBox
    Left = 12
    Top = 10
    Width = 376
    Height = 256
    Caption = 'Connect through an SSH Server'
    TabOrder = 0
    object SSHHostLbl: TLabel
      Left = 8
      Top = 29
      Width = 110
      Height = 13
      Alignment = taRightJustify
      AutoSize = False
      Caption = 'SSH Host:'
    end
    object SSHHostEd: TEdit
      Left = 124
      Top = 25
      Width = 160
      Height = 21
      TabOrder = 0
      OnChange = FieldChange
    end
    object SSHPortLbl: TLabel
      Left = 292
      Top = 29
      Width = 30
      Height = 13
      Caption = 'Port:'
    end
    object SSHPortEd: TEdit
      Left = 326
      Top = 25
      Width = 38
      Height = 21
      TabOrder = 1
    end
    object SSHUserLbl: TLabel
      Left = 8
      Top = 57
      Width = 110
      Height = 13
      Alignment = taRightJustify
      AutoSize = False
      Caption = 'Username:'
    end
    object SSHUserEd: TEdit
      Left = 124
      Top = 53
      Width = 160
      Height = 21
      TabOrder = 2
    end
    object SSHAuthLbl: TLabel
      Left = 8
      Top = 85
      Width = 110
      Height = 13
      Alignment = taRightJustify
      AutoSize = False
      Caption = 'Login with:'
    end
    object SSHAgentRBtn: TRadioButton
      Left = 124
      Top = 84
      Width = 240
      Height = 17
      Caption = 'SSH agent (ssh-agent, Pageant)'
      Checked = True
      TabOrder = 3
      TabStop = True
      OnClick = FieldChange
    end
    object SSHKeyRBtn: TRadioButton
      Left = 124
      Top = 108
      Width = 90
      Height = 17
      Caption = 'Key file:'
      TabOrder = 4
      OnClick = FieldChange
    end
    object SSHKeyEd: TEdit
      Left = 216
      Top = 106
      Width = 112
      Height = 21
      Enabled = False
      TabOrder = 5
      OnChange = FieldChange
    end
    object SSHKeyBtn: TBitBtn
      Left = 332
      Top = 105
      Width = 21
      Height = 23
      Caption = '...'
      Enabled = False
      TabOrder = 6
      OnClick = SSHKeyBtnClick
    end
    object SSHPasswordRBtn: TRadioButton
      Left = 124
      Top = 132
      Width = 90
      Height = 17
      Caption = 'Password:'
      TabOrder = 7
      OnClick = FieldChange
    end
    object SSHPasswordEd: TEdit
      Left = 216
      Top = 130
      Width = 148
      Height = 21
      Enabled = False
      EchoMode = emPassword
      PasswordChar = '*'
      TabOrder = 8
    end
    object SSHNoteLbl: TLabel
      Left = 14
      Top = 160
      Width = 348
      Height = 76
      AutoSize = False
      Caption = 'Server Host and Port are reached from the SSH server. Host aliases, keys and jump hosts from ~/.ssh/config apply; host keys are checked against ~/.ssh/known_hosts.'
      Font.Color = clGrayText
      ParentFont = False
      WordWrap = True
    end
  end
  object OKBtn: TButton
    Left = 232
    Top = 276
    Width = 75
    Height = 25
    Caption = 'OK'
    Default = True
    ModalResult = 1
    TabOrder = 1
  end
  object CancelBtn: TButton
    Left = 313
    Top = 276
    Width = 75
    Height = 25
    Cancel = True
    Caption = 'Cancel'
    ModalResult = 2
    TabOrder = 2
  end
end
